{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "living-architecture.schema.json",
  "title": "living-architecture.yaml",
  "description": "Per-repo configuration at the repo root. Every key is optional in the schema; absent keys take their defaults, and the format check requires format.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format": {
      "$ref": "trmv.schema.json#/properties/format"
    },
    "exempt": {
      "$ref": "trmv.schema.json#/properties/exempt"
    },
    "tracker": {
      "enum": [
        "linear",
        "github",
        "none"
      ],
      "default": "linear",
      "description": "Where issues live and, with openspec off, where the plan is persisted."
    },
    "openspec": {
      "type": "boolean",
      "default": true,
      "description": "The flow keeps specs and changes under openspec/."
    },
    "architecture": {
      "type": "boolean",
      "default": false,
      "description": "The repo has a living-architecture model (architecture/index.yaml)."
    },
    "reviewers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "codex": {
          "type": "boolean",
          "default": true,
          "description": "The flow runs Codex reviews; a missing Codex server stops it."
        },
        "sonar": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "project_key": {
              "type": [
                "string",
                "null"
              ],
              "default": null,
              "description": "Overrides the Sonar project key otherwise inferred per PR."
            }
          }
        }
      }
    },
    "issue_key_pattern": {
      "type": "string",
      "default": "[A-Z][A-Z0-9]+-\\d+",
      "description": "Full-match pattern for [target: <id>] tags; must use the portable regex subset (regex-subset.md)."
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test": {
          "$ref": "trmv.schema.json#/properties/commands/properties/test"
        },
        "lint": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "typecheck": {
          "$ref": "trmv.schema.json#/properties/commands/properties/typecheck"
        }
      }
    },
    "refactor": {
      "$ref": "trmv.schema.json#/properties/refactor"
    },
    "conventions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text_ratio_max": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.15,
          "description": "Cap on comment/docstring-only lines, as a fraction of each changed file group."
        },
        "rules": {
          "type": "array",
          "items": {
            "enum": [
              "import-not-top",
              "text-ratio",
              "composite-assert",
              "raises-single-throw"
            ]
          },
          "default": [
            "import-not-top",
            "text-ratio",
            "composite-assert",
            "raises-single-throw"
          ],
          "description": "The conventions rule ids the gate enforces (conventions.yaml); [] turns the gate off."
        }
      }
    },
    "leaks": {
      "type": "object",
      "additionalProperties": false,
      "description": "Stealth config only: la-leak-check's tolerated tokens.",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Waivable leak tokens (vectors/stealth-leaks.yaml) that la-leak-check does not report."
        }
      }
    }
  }
}
