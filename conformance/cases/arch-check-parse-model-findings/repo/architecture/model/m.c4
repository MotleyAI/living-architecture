specification {
  element system
  element node
  element bucket { #virtual }
  tag legacy
  tag virtual
  #virtual
  colour red
}

model {
  python = system 'Python' {
    api = node 'API' {
      metadata {
        package 'pkg.api'
        arc42 'architecture/api.arc42.md'
        specs ['api']
      }
      handlers = node 'Handlers'
      api.handlers -> core
    }
    core = node 'Core' { // a comment
      metadata {
        package 'pkg.core'
        claims ['pkg.util']
      }
    }
    store = node 'Store // not a comment' {
      metadata {
        package 'pkg.store'
      }
    }
    legacy = bucket 'Legacy' {
      metadata {
        packages ['pkg.old']
      }
    }
    core = node 'Again'
    thing = widget 'Thing' {
      metadata {
        package 'pkg.thing'
      }
    }
    core -> store
    core -> store
    api -> store #legacy
    legacy -> core
    core -> ghost
    api.handlers -> core
    this is not a model line
  }
}

views {
  view ignored {
  }
}
