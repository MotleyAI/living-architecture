#!/bin/sh
[ -d .git ] && [ -f tsconfig.json ] || { echo "fake tsc: not run at the repo root: $(pwd)" >&2; exit 99; }
case " $* " in *" --noEmit "*) ;; *) echo "fake tsc: unexpected args: $*" >&2; exit 99 ;; esac
case " $* " in *" --pretty false "*) ;; *) echo "fake tsc: no --pretty false: $*" >&2; exit 99 ;; esac
cat >&2 <<'EOF'
Error: Cannot find module 'typescript/lib/tsc.js'
EOF
exit 1
