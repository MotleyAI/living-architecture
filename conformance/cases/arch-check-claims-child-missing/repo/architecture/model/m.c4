specification {
  element node
  element bucket {
    #virtual
  }
  tag legacy
}

model {
  api = node 'API' {
    handlers = node 'Handlers'
    ghost = node 'Ghost'
  }
  core = node 'Core'
  store = node 'Store'
  legacy = bucket 'Legacy'

  api.handlers -> core
  core -> store
  api -> store #legacy
  legacy -> core
}
