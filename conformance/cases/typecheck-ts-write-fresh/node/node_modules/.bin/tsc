#!/bin/sh
[ -d .git ] && [ -f tsconfig.json ] || { echo "fake tsc: not run at the repo root: $(pwd)" >&2; exit 99; }
case " $* " in *" --noEmit "*) ;; *) echo "fake tsc: unexpected args: $*" >&2; exit 99 ;; esac
case " $* " in *" --pretty false "*) ;; *) echo "fake tsc: no --pretty false: $*" >&2; exit 99 ;; esac
cat <<'EOF'
src/b.ts(2,1): error TS2304: Cannot find name 'missing'.
src/a.ts(6,10): error TS2345: Argument of type 'number' is not assignable to parameter of type 'string'.
src/a.ts(1,14): error TS2322: Type 'string' is not assignable to type 'number'.
src/a.ts(2,7): error TS2322: Type 'boolean' is not assignable to type 'number'.
src/a.ts(3,14): error TS2322: Type 'string' is not assignable to type 'number'.
EOF
exit 2
