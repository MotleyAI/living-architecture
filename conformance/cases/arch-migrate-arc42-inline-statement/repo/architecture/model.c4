specification {
  element system
  element node
  element bucket {
    #virtual
  }
  tag legacy
  tag virtual
}

model {
  python = system 'Python' {
    api = node 'API' {
      metadata { package 'pkg.api' arc42 'architecture/api.arc42.md' specs ['api'] }
      handlers = node 'Handlers' { metadata { arc42 'architecture/handlers.arc42.md' } }
    }
    core = node 'Core' {
      metadata {
        arc42 'architecture/core.arc42.md' package 'pkg.core' // core doc
        claims ['pkg.util']
      }
    }
    store = node 'Store' {
      metadata {
        package 'pkg.store'
      }
    }
    legacy = bucket 'Legacy' {
      metadata {
        packages ['pkg.old']
      }
    }

    api.handlers -> core
    core -> store
    api -> store #legacy
    legacy -> core
  }
}
