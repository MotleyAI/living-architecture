specification {
  element system
  element node
}

model {
  python = system 'Python' {
    api = node 'API' {
      metadata {
        package 'pkg.api'
        specs ['api']
      }
    }
    core = node 'Core' {
      metadata {
        package 'pkg.core'
      }
    }

    api -> core
  }
  typescript = system 'Web' {
    api = node 'Web API' {
      metadata {
        package 'src/api'
        specs ['web']
      }
    }
    core = node 'Web core' {
      metadata {
        package 'src/core'
      }
    }

    api -> core
  }
}
