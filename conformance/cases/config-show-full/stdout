{
  "format": "<FORMAT>",
  "tracker": "github",
  "openspec": false,
  "architecture": true,
  "reviewers": {
    "codex": false,
    "sonar": {
      "project_key": "acme_widgets"
    }
  },
  "issue_key_pattern": "#\\d+",
  "commands": {
    "test": "uv run pytest -q",
    "lint": "uv run ruff check .",
    "typecheck": {
      "python": "basedpyright",
      "typescript": "tsc --noEmit"
    }
  },
  "refactor": {
    "python": {
      "moved_module_stub": null
    },
    "string_forms": []
  },
  "conventions": {
    "text_ratio_max": 0.3,
    "exempt": [
      "gen/*",
      "*_pb2.py"
    ],
    "rules": [
      "import-not-top",
      "text-ratio"
    ]
  }
}
