#!/bin/sh
[ -d .git ] && [ -f pyproject.toml ] || { echo "fake basedpyright: not run at the repo root: $(pwd)" >&2; exit 99; }
[ "$*" = "--writebaseline" ] || { echo "fake basedpyright: unexpected args: $*" >&2; exit 99; }
mkdir -p .basedpyright
printf '%s\n' '{"files": {"./src/m.py": [{"code": "reportAssignmentType"}]}}' > .basedpyright/baseline.json
cat <<'EOF'
src/m.py
  src/m.py:1:5 - error: Type "Literal['x']" is not assignable to declared type "int" (reportAssignmentType)
1 error, 0 warnings, 0 notes
updated ./.basedpyright/baseline.json with 1 error
EOF
exit 1
