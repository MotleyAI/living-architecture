#!/bin/sh
# Fake tsc: one TS2322 per line assigning 'x', at the checkout root or a linked worktree's root.
[ -e .git ] && [ -f tsconfig.json ] || { echo "fake tsc: not run at a checkout root: $(pwd)" >&2; exit 99; }
case " $* " in *" --noEmit "*) ;; *) echo "fake tsc: unexpected args: $*" >&2; exit 99 ;; esac
case " $* " in *" --pretty false "*) ;; *) echo "fake tsc: no --pretty false: $*" >&2; exit 99 ;; esac
found=0
for f in src/*.ts; do
  grep -n "= 'x'" "$f" | while IFS=: read -r n _; do
    echo "$f($n,14): error TS2322: Type 'string' is not assignable to type 'number'."
  done
  grep -q "= 'x'" "$f" && found=1
done
[ "$found" = 1 ] && exit 2
exit 0
