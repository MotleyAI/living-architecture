Renaming <Model> to <Dataset>:


--- a/pkg/g.py
+++ b/pkg/g.py
@@ -1,4 +1,4 @@
-class Model:
+class Dataset:
     name: str = ""
 
 
@@ -6,12 +6,12 @@
     name: str = ""
 
 
-SCHEMA = "CREATE NODE TABLE Model(name STRING, PRIMARY KEY(name))"
-FIND = "MATCH (m:Model) RETURN m.name"
+SCHEMA = "CREATE NODE TABLE Dataset(name STRING, PRIMARY KEY(name))"
+FIND = "MATCH (m:Dataset) RETURN m.name"
 
 
 def find(i: int) -> str:
-    return f"MATCH (m:Model) WHERE m.id = {i}"
+    return f"MATCH (m:Dataset) WHERE m.id = {i}"
 
 
 OTHER = "MATCH (m:ModelColumn)"



