specification {
  element system
  element node
  tag legacy
  tag virtual
}
model {
  python = system 'PyPI twins' {
    trmv = node 'type-rename-move' {
      metadata {
        package 'trmv'
      }
      contract = node 'Shared contract'
      config = node 'Config'
      lang = node 'Language adapter'
      twin = node 'Twin forwarding' {
        metadata {
          specs ['twin-forwarding']
        }
      }
      changes = node 'Change set'
      typecheck = node 'Type check' {
        metadata {
          specs ['typecheck']
        }
      }
      refactor = node 'Rename and move' {
        metadata {
          specs ['refactor']
        }
      }
      doctor = node 'Doctor'
      cli = node 'CLI'
    }
    la = node 'living-architecture' {
      metadata {
        package 'living_architecture'
      }
      contract = node 'Shared contract'
      config = node 'Config'
      cli = node 'CLI'
      c4 = node 'LikeC4 model' {
        metadata {
          specs ['c4-layout']
        }
      }
      archcheck = node 'Architecture check' {
        metadata {
          specs ['arch-check', 'arch-scaffold']
        }
      }
      conventions = node 'Conventions and comments' {
        metadata {
          specs ['conventions']
        }
      }
      review = node 'Review shims' {
        metadata {
          specs ['review-detection', 'failed-pr-checks']
        }
      }
      doctor = node 'Doctor'
      affected = node 'Affected tests' {
        metadata {
          specs ['affected-tests']
        }
      }
      leaks = node 'Leak check' {
        metadata {
          specs ['stealth-leaks']
        }
      }
    }

    la -> trmv
    trmv.changes -> trmv.config
    trmv.changes -> trmv.contract
    trmv.cli -> trmv.config
    trmv.cli -> trmv.doctor
    trmv.cli -> trmv.refactor
    trmv.cli -> trmv.twin
    trmv.cli -> trmv.typecheck
    trmv.config -> trmv.contract
    trmv.doctor -> trmv.config
    trmv.doctor -> trmv.contract
    trmv.doctor -> trmv.twin
    trmv.lang -> trmv.contract
    trmv.refactor -> trmv.changes
    trmv.refactor -> trmv.config
    trmv.refactor -> trmv.contract
    trmv.refactor -> trmv.lang
    trmv.refactor -> trmv.twin
    trmv.refactor -> trmv.typecheck
    trmv.twin -> trmv.contract
    trmv.typecheck -> trmv.changes
    trmv.typecheck -> trmv.config
    trmv.typecheck -> trmv.contract
    trmv.typecheck -> trmv.lang
    trmv.typecheck -> trmv.twin
    la.affected -> la.contract
    la.archcheck -> la.c4
    la.archcheck -> la.config
    la.archcheck -> la.contract
    la.c4 -> la.contract
    la.cli -> la.affected
    la.cli -> la.archcheck
    la.cli -> la.c4
    la.cli -> la.config
    la.cli -> la.contract
    la.cli -> la.conventions
    la.cli -> la.doctor
    la.cli -> la.leaks
    la.cli -> la.review
    la.config -> la.contract
    la.conventions -> la.config
    la.conventions -> la.contract
    la.doctor -> la.config
    la.doctor -> la.contract
    la.leaks -> la.config
    la.leaks -> la.contract
    la.review -> la.contract
  }
  typescript = system 'npm twins' {
    trmv = node 'type-rename-move' {
      metadata {
        package 'trmv/src'
      }
      contract = node 'Shared contract'
      config = node 'Config'
      lang = node 'Language adapter'
      twin = node 'Twin forwarding'
      changes = node 'Change set'
      typecheck = node 'Type check'
      refactor = node 'Rename and move'
      doctor = node 'Doctor'
      cli = node 'CLI'
    }
    la = node 'living-architecture' {
      metadata {
        package 'la/src'
      }
      contract = node 'Shared contract'
      config = node 'Config'
      cli = node 'CLI'
      c4 = node 'LikeC4 model'
      archcheck = node 'Architecture check'
      conventions = node 'Conventions and comments'
      review = node 'Review shims'
      doctor = node 'Doctor'
      affected = node 'Affected tests'
      leaks = node 'Leak check'
    }

    la -> trmv
    trmv.changes -> trmv.config
    trmv.changes -> trmv.contract
    trmv.cli -> trmv.config
    trmv.cli -> trmv.doctor
    trmv.cli -> trmv.refactor
    trmv.cli -> trmv.twin
    trmv.cli -> trmv.typecheck
    trmv.config -> trmv.contract
    trmv.config -> trmv.twin
    trmv.doctor -> trmv.config
    trmv.doctor -> trmv.contract
    trmv.doctor -> trmv.twin
    trmv.lang -> trmv.contract
    trmv.refactor -> trmv.changes
    trmv.refactor -> trmv.config
    trmv.refactor -> trmv.contract
    trmv.refactor -> trmv.lang
    trmv.refactor -> trmv.twin
    trmv.twin -> trmv.contract
    trmv.typecheck -> trmv.changes
    trmv.typecheck -> trmv.config
    trmv.typecheck -> trmv.contract
    trmv.typecheck -> trmv.lang
    trmv.typecheck -> trmv.twin
    la.affected -> la.contract
    la.archcheck -> la.c4
    la.archcheck -> la.config
    la.archcheck -> la.contract
    la.c4 -> la.contract
    la.cli -> la.affected
    la.cli -> la.archcheck
    la.cli -> la.c4
    la.cli -> la.config
    la.cli -> la.contract
    la.cli -> la.conventions
    la.cli -> la.doctor
    la.cli -> la.leaks
    la.cli -> la.review
    la.config -> la.contract
    la.conventions -> la.config
    la.conventions -> la.contract
    la.doctor -> la.config
    la.doctor -> la.contract
    la.leaks -> la.config
    la.leaks -> la.contract
    la.review -> la.contract
  }
}
