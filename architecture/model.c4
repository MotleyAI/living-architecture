specification {
  element system
  element node
  tag legacy
  tag virtual
}
model {
  python = system 'PyPI twins' {
    dr = node 'deterministic-refactor' {
      metadata {
        package 'deterministic_refactor'
      }
      contract = node 'Shared contract'
      config = node 'Config'
      lang = node 'Language adapter'
      twin = node 'Twin forwarding' {
        metadata {
          specs ['twin-forwarding']
        }
      }
      changes = node 'Change set'
      typecheck = node 'Type check' {
        metadata {
          specs ['typecheck']
        }
      }
      refactor = node 'Deterministic refactoring' {
        metadata {
          specs ['refactor']
        }
      }
      doctor = node 'Doctor'
      cli = node 'CLI'
    }
    la = node 'living-architecture' {
      metadata {
        package 'living_architecture'
      }
      contract = node 'Shared contract'
      config = node 'Config'
      cli = node 'CLI'
      c4 = node 'LikeC4 model' {
        metadata {
          specs ['c4-layout']
        }
      }
      archcheck = node 'Architecture check' {
        metadata {
          specs ['arch-check', 'arch-scaffold']
        }
      }
      conventions = node 'Conventions and comments' {
        metadata {
          specs ['conventions']
        }
      }
      review = node 'Review shims' {
        metadata {
          specs ['review-detection', 'failed-pr-checks']
        }
      }
      doctor = node 'Doctor'
      affected = node 'Affected tests' {
        metadata {
          specs ['affected-tests']
        }
      }
    }

    la -> dr
    dr.changes -> dr.config
    dr.changes -> dr.contract
    dr.cli -> dr.config
    dr.cli -> dr.doctor
    dr.cli -> dr.refactor
    dr.cli -> dr.twin
    dr.cli -> dr.typecheck
    dr.config -> dr.contract
    dr.doctor -> dr.config
    dr.doctor -> dr.contract
    dr.doctor -> dr.twin
    dr.lang -> dr.contract
    dr.refactor -> dr.changes
    dr.refactor -> dr.config
    dr.refactor -> dr.contract
    dr.refactor -> dr.lang
    dr.refactor -> dr.twin
    dr.refactor -> dr.typecheck
    dr.twin -> dr.contract
    dr.typecheck -> dr.changes
    dr.typecheck -> dr.config
    dr.typecheck -> dr.contract
    dr.typecheck -> dr.lang
    dr.typecheck -> dr.twin
    la.affected -> la.contract
    la.archcheck -> la.c4
    la.archcheck -> la.config
    la.archcheck -> la.contract
    la.c4 -> la.contract
    la.cli -> la.affected
    la.cli -> la.archcheck
    la.cli -> la.c4
    la.cli -> la.config
    la.cli -> la.contract
    la.cli -> la.conventions
    la.cli -> la.doctor
    la.cli -> la.review
    la.config -> la.contract
    la.conventions -> la.config
    la.conventions -> la.contract
    la.doctor -> la.config
    la.doctor -> la.contract
    la.review -> la.contract
  }
  typescript = system 'npm twins' {
    dr = node 'deterministic-refactor' {
      metadata {
        package 'dr/src'
      }
      contract = node 'Shared contract'
      config = node 'Config'
      lang = node 'Language adapter'
      twin = node 'Twin forwarding'
      changes = node 'Change set'
      typecheck = node 'Type check'
      refactor = node 'Deterministic refactoring'
      doctor = node 'Doctor'
      cli = node 'CLI'
    }
    la = node 'living-architecture' {
      metadata {
        package 'la/src'
      }
      contract = node 'Shared contract'
      config = node 'Config'
      cli = node 'CLI'
      c4 = node 'LikeC4 model'
      archcheck = node 'Architecture check'
      conventions = node 'Conventions and comments'
      review = node 'Review shims'
      doctor = node 'Doctor'
      affected = node 'Affected tests'
    }

    la -> dr
    dr.changes -> dr.config
    dr.changes -> dr.contract
    dr.cli -> dr.config
    dr.cli -> dr.doctor
    dr.cli -> dr.refactor
    dr.cli -> dr.twin
    dr.cli -> dr.typecheck
    dr.config -> dr.contract
    dr.config -> dr.twin
    dr.doctor -> dr.config
    dr.doctor -> dr.contract
    dr.doctor -> dr.twin
    dr.lang -> dr.contract
    dr.refactor -> dr.changes
    dr.refactor -> dr.config
    dr.refactor -> dr.contract
    dr.refactor -> dr.lang
    dr.refactor -> dr.twin
    dr.twin -> dr.contract
    dr.typecheck -> dr.changes
    dr.typecheck -> dr.config
    dr.typecheck -> dr.contract
    dr.typecheck -> dr.lang
    dr.typecheck -> dr.twin
    la.affected -> la.contract
    la.archcheck -> la.c4
    la.archcheck -> la.config
    la.archcheck -> la.contract
    la.c4 -> la.contract
    la.cli -> la.affected
    la.cli -> la.archcheck
    la.cli -> la.c4
    la.cli -> la.config
    la.cli -> la.contract
    la.cli -> la.conventions
    la.cli -> la.doctor
    la.cli -> la.review
    la.config -> la.contract
    la.conventions -> la.config
    la.conventions -> la.contract
    la.doctor -> la.config
    la.doctor -> la.contract
    la.review -> la.contract
  }
}
