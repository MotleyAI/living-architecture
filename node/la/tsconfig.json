{
  "compilerOptions": {
    "target": "es2023",
    "lib": [
      "es2023"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {
      "deterministic-refactor": [
        "../dr/src"
      ],
      "deterministic-refactor/*": [
        "../dr/src/*/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test"
  ]
}
