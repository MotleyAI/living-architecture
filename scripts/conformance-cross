#!/usr/bin/env bash
# Run every conformance case through both twins' entry points (the cross-twin run).
# Usage: scripts/conformance-cross [pytest args...]
set -euo pipefail
cd "$(dirname "$0")/../node"
npm run --silent build
status=0
for twin in python typescript; do
  echo "== cross-twin run invoked through the $twin twin"
  LA_CONFORMANCE_CROSS=1 LA_CONFORMANCE_TWIN="$twin" npm run --silent conformance -- "$@" || status=1
done
exit "$status"
