#!/usr/bin/env python3
"""Vendor shared/ into each twin's contract snapshot (with CONTRACT_HASH), plus README.md and LICENSE.

Usage: scripts/sync-shared [--check]   (--check: exit 1 if any copy is stale, writing nothing)
"""

from __future__ import annotations

import hashlib
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SHARED = ROOT / "shared"
HASH_FILE = "CONTRACT_HASH"
SNAPSHOTS = [ROOT / "python" / "src" / "living_architecture" / "contract" / "data", ROOT / "node" / "src" / "contract" / "data"]
VENDORED = {ROOT / twin / name: ROOT / name for twin in ("python", "node") for name in ("README.md", "LICENSE")}


def _files(root: Path) -> list[Path]:
    return sorted(
        (p for p in root.rglob("*") if p.is_file() and p.name != HASH_FILE),
        key=lambda p: p.relative_to(root).as_posix().encode("utf-8"),
    )


def compute_hash(root: Path) -> str:
    digest = hashlib.sha256()
    for path in _files(root):
        data = path.read_bytes()
        executable = b"1" if path.stat().st_mode & 0o111 else b"0"
        rel = path.relative_to(root).as_posix().encode("utf-8")
        digest.update(b"\0".join([rel, executable, str(len(data)).encode("ascii"), data]))
    return digest.hexdigest()


def _tree(root: Path) -> dict[str, tuple[bool, bytes]]:
    if not root.is_dir():
        return {}
    return {p.relative_to(root).as_posix(): (bool(p.stat().st_mode & 0o111), p.read_bytes()) for p in _files(root)}


def _snapshot_is_current(snapshot: Path, expected_hash: str) -> bool:
    hash_path = snapshot / HASH_FILE
    recorded = hash_path.read_text(encoding="utf-8").strip() if hash_path.is_file() else None
    return _tree(snapshot) == _tree(SHARED) and recorded == expected_hash


def main(argv: list[str]) -> int:
    check = argv == ["--check"]
    if argv and not check:
        print(__doc__, file=sys.stderr)
        return 2
    expected = compute_hash(SHARED)
    stale = [s for s in SNAPSHOTS if not _snapshot_is_current(s, expected)]
    stale += [dst for dst, src in VENDORED.items() if not dst.is_file() or dst.read_bytes() != src.read_bytes()]
    if check:
        for path in stale:
            print(f"stale: {path.relative_to(ROOT)}; run scripts/sync-shared", file=sys.stderr)
        return 1 if stale else 0
    for snapshot in SNAPSHOTS:
        if snapshot.exists():
            shutil.rmtree(snapshot)
        shutil.copytree(SHARED, snapshot)
        (snapshot / HASH_FILE).write_text(expected + "\n", encoding="utf-8")
    for dst, src in VENDORED.items():
        shutil.copy2(src, dst)
    for path in stale:
        print(f"synced: {path.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
