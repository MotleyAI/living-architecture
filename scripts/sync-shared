#!/usr/bin/env python3
"""Vendor each package's shared/<package>/ into both its twins' contract snapshots (each with its CONTRACT_HASH).

Usage: scripts/sync-shared [--check]   (--check: exit 1 if any copy is stale, writing nothing)
"""

from __future__ import annotations

import shutil
import sys
from pathlib import Path

from contract_hash import HASH_FILE, compute_hash, contract_files

ROOT = Path(__file__).resolve().parent.parent
SHARED = ROOT / "shared"
# Each twin's snapshot, by the package whose contract it vendors.
SNAPSHOTS = {
    ROOT / "python" / "dr" / "src" / "deterministic_refactor" / "contract" / "data": "dr",
    ROOT / "python" / "la" / "src" / "living_architecture" / "contract" / "data": "la",
    ROOT / "node" / "dr" / "src" / "contract" / "data": "dr",
    ROOT / "node" / "la" / "src" / "contract" / "data": "la",
}


def _tree(root: Path) -> dict[str, tuple[bool, bytes]]:
    if not root.is_dir():
        return {}
    return {p.relative_to(root).as_posix(): (bool(p.stat().st_mode & 0o111), p.read_bytes()) for p in contract_files(root)}


def _snapshot_is_current(snapshot: Path, source: Path, expected_hash: str) -> bool:
    hash_path = snapshot / HASH_FILE
    recorded = hash_path.read_text(encoding="utf-8").strip() if hash_path.is_file() else None
    return _tree(snapshot) == _tree(source) and recorded == expected_hash


def main(argv: list[str]) -> int:
    check = argv == ["--check"]
    if argv and not check:
        print(__doc__, file=sys.stderr)
        return 2
    expected = {package: compute_hash(SHARED / package) for package in sorted(set(SNAPSHOTS.values()))}
    stale = [s for s, pkg in SNAPSHOTS.items() if not _snapshot_is_current(s, SHARED / pkg, expected[pkg])]
    if check:
        for path in stale:
            print(f"stale: {path.relative_to(ROOT)}; run scripts/sync-shared", file=sys.stderr)
        return 1 if stale else 0
    for snapshot, package in SNAPSHOTS.items():
        if snapshot.exists():
            shutil.rmtree(snapshot)
        shutil.copytree(SHARED / package, snapshot)
        (snapshot / HASH_FILE).write_text(expected[package] + "\n", encoding="utf-8")
    for path in stale:
        print(f"synced: {path.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
